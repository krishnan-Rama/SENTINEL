# SENTINEL project configuration
# ---------------------------------------------------------------------------
# Defaults for a run. Anything here can be overridden on the command line, so
# keep the stable things (cluster partitions, thresholds) here and pass the
# changeable things (--outdir, --species-tree) as flags.
#
#   cp config/project.env config/my_run.env
#   $EDITOR config/my_run.env
#   bin/sentinel -c config/my_run.env doctor
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
PROJECT_NAME="chlorpyrifos_ache"
CHEMICAL="chlorpyrifos"
TARGET="acetylcholinesterase"

# --- where everything is written (same as --outdir) -------------------------
RUN_DIR="${HOME}/sentinel_runs/chlorpyrifos_ache"

# --- inputs you supply ------------------------------------------------------
# Cleaned toxicity export, one row per species. See docs/INPUTS.md.
ECOTOX_TABLE=""

# Sent to UniProt in the User-Agent header. Requests without one are throttled.
UNIPROT_CONTACT=""

# Dated species tree in Newick. Strongly recommended: without it the pipeline
# falls back to the target gene tree, which is fine for deciding what a
# sequence is and not fine for anything phylogenetic downstream.
SPECIES_TREE=""

# --- cluster ----------------------------------------------------------------
GPU_PARTITION=""          # --gpu-partition, used by stage 5B
CPU_PARTITION=""          # --partition, used by 8D, 3C, 5C
SLURM_ACCOUNT=""          # --account
CFG_THREADS=16            # --threads
FOLD_CHUNK=12             # --chunk, sequences per folding array task

# --- analysis ---------------------------------------------------------------
MIN_ICC=0.75              # reliability floor for structural descriptors
MIN_CLADE_N=8             # smallest clade given its own within-clade refit
DOMAIN_START=1            # target domain range in the reference numbering
DOMAIN_END=537
